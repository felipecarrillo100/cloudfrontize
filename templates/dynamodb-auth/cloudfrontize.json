{
  "$schema": "https://raw.githubusercontent.com/felipecarrillo100/cloudfrontize/main/schema/cloudfrontize.schema.json",
  "version": 1,
  "name": "Template",
  "origins": [
    {
      "id": "website",
      "type": "local",
      "path": "origins/www"
    }
  ],
  "functions": {
    "dynamo-auth": {
      "type": "lambda-edge",
      "runtime": "nodejs22.x",
      "file": "functions/lambda-edge/origin-request.dynamo-auth.js"
    }
  },
  "behaviors": [
    {
      "pathPattern": "/members/*",
      "origin": "website",
      "functions": {
        "origin-request": "dynamo-auth"
      }
    }
  ],
  "defaultBehavior": {
    "origin": "website",
    "functions": {}
  }
}
