{
  "$schema": "https://raw.githubusercontent.com/felipecarrillo100/cloudfrontize/main/schema/cloudfrontize.schema.json",
  "version": 1,
  "name": "Template",
  "origins": [
    {
      "id": "website",
      "type": "local",
      "path": "origins/www"
    }
  ],
  "functions": {
    "basic-auth": {
      "type": "cloudfront-function",
      "runtime": "cloudfront-js-2.0",
      "file": "functions/cloudfront/viewer-request.basic-auth.js"
    }
  },
  "behaviors": [
    {
      "pathPattern": "/admin/*",
      "origin": "website",
      "functions": {
        "viewer-request": "basic-auth"
      }
    }
  ],
  "defaultBehavior": {
    "origin": "website",
    "functions": {}
  }
}
