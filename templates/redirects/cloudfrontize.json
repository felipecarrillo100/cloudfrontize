{
  "$schema": "https://raw.githubusercontent.com/felipecarrillo100/cloudfrontize/main/schema/cloudfrontize.schema.json",
  "version": 1,
  "name": "Template",
  "origins": [
    {
      "id": "website",
      "type": "local",
      "path": "origins/www"
    }
  ],
  "functions": {
    "redirects": {
      "type": "cloudfront-function",
      "runtime": "cloudfront-js-2.0",
      "file": "functions/cloudfront/viewer-request.redirects.js",
      "keyValueStore": "redirects"
    }
  },
  "keyValueStores": {
    "redirects": {
      "file": "kvs/redirects.json"
    }
  },
  "defaultBehavior": {
    "origin": "website",
    "functions": {
      "viewer-request": "redirects"
    }
  }
}
