{
  "$schema": "https://raw.githubusercontent.com/felipecarrillo100/cloudfrontize/main/schema/cloudfrontize.schema.json",
  "version": 1,
  "name": "Template",
  "origins": [
    {
      "id": "website",
      "type": "local",
      "path": "origins/www"
    }
  ],
  "functions": {
    "geo-router": {
      "type": "lambda-edge",
      "runtime": "nodejs22.x",
      "file": "functions/lambda-edge/origin-request.geo-router.js"
    }
  },
  "defaultBehavior": {
    "origin": "website",
    "functions": {
      "origin-request": "geo-router"
    }
  },
  "viewer": {
    "headers": "config/headers.json"
  }
}
