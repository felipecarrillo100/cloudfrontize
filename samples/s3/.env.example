# CloudFrontize S3 Sync Configuration
# Copy this to .env and modify as needed

# --- MinIO Example ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin123
# S3_MODE=website

# --- LocalStack Example (Defaults) ---
# S3_ENDPOINT=http://localhost:4566
# S3_REGION=us-east-1
# S3_ACCESS_KEY=test
# S3_SECRET_KEY=test
# S3_MODE=website

# Parallel workers for uploads
S3_CONCURRENCY=10
