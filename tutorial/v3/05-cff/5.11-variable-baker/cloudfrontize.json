{
  "$schema": "https://raw.githubusercontent.com/felipecarrillo100/cloudfrontize/main/schema/cloudfrontize.schema.json",
  "version": 1,
  "name": "5.11 The Variable Baker",
  "origins": [
    {
      "id": "website",
      "type": "local",
      "path": "origins/www"
    }
  ],
  "functions": {
    "variable-baker": {
      "type": "cloudfront-function",
      "runtime": "cloudfront-js-2.0",
      "file": "functions/cloudfront/viewer-response.variable-baker.js"
    }
  },
  "defaultBehavior": {
    "origin": "website",
    "functions": {
      "viewer-response": "variable-baker"
    }
  },
  "bake": {
    "file": "config/bake.env"
  }
}
