{
  "$schema": "https://raw.githubusercontent.com/felipecarrillo100/cloudfrontize/main/schema/cloudfrontize.schema.json",
  "version": 1,
  "name": "5.3 The Simple Blocker",
  "origins": [
    {
      "id": "website",
      "type": "local",
      "path": "origins/www"
    }
  ],
  "functions": {
    "simple-blocker": {
      "type": "cloudfront-function",
      "runtime": "cloudfront-js-2.0",
      "file": "functions/cloudfront/viewer-request.simple-blocker.js"
    }
  },
  "defaultBehavior": {
    "origin": "website",
    "functions": {
      "viewer-request": "simple-blocker"
    }
  }
}
