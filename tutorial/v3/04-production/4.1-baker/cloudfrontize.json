{
  "$schema": "https://raw.githubusercontent.com/felipecarrillo100/cloudfrontize/main/schema/cloudfrontize.schema.json",
  "version": 1,
  "name": "4.1 The Baker",
  "origins": [
    {
      "id": "website",
      "type": "local",
      "path": "origins/www"
    }
  ],
  "functions": {
    "baker": {
      "type": "lambda-edge",
      "runtime": "nodejs22.x",
      "file": "functions/lambda-edge/viewer-response.baker.js"
    }
  },
  "defaultBehavior": {
    "origin": "website",
    "functions": {
      "viewer-response": "baker"
    }
  },
  "bake": {
    "file": "config/bake.env"
  }
}
