{
  "$schema": "https://raw.githubusercontent.com/felipecarrillo100/cloudfrontize/main/schema/cloudfrontize.schema.json",
  "version": 1,
  "name": "1.2 The Librarian",
  "origins": [
    {
      "id": "website",
      "type": "local",
      "path": "origins/www"
    }
  ],
  "functions": {
    "librarian": {
      "type": "lambda-edge",
      "runtime": "nodejs22.x",
      "file": "functions/lambda-edge/viewer-request.librarian.js"
    },
    "query-echo": {
      "type": "lambda-edge",
      "runtime": "nodejs22.x",
      "file": "functions/lambda-edge/viewer-response.query-echo.js"
    }
  },
  "defaultBehavior": {
    "origin": "website",
    "functions": {
      "viewer-request": "librarian",
      "viewer-response": "query-echo"
    }
  }
}
