{
  "$schema": "https://raw.githubusercontent.com/felipecarrillo100/cloudfrontize/main/schema/cloudfrontize.schema.json",
  "version": 1,
  "name": "1.1 The Security Guard",
  "origins": [
    { "id": "website", "type": "local", "path": "origins/www" }
  ],
  "functions": {
    "security-guard": {
      "type": "lambda-edge",
      "runtime": "nodejs22.x",
      "file": "functions/lambda-edge/viewer-response.security-guard.js"
    }
  },
  "defaultBehavior": {
    "origin": "website",
    "functions": { "viewer-response": "security-guard" }
  }
}
