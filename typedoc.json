{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/pipeline/Orchestrator.ts",
    "src/core/EdgeRunner.ts",
    "src/core/CFFRunner.ts",
    "src/pipeline/Providers/base.ts",
    "src/pipeline/Providers/S3Provider.ts",
    "src/pipeline/Providers/LocalProvider.ts",
    "src/pipeline/ConfigLoader.ts",
    "src/headerParser.ts",
    "src/core/HeaderManager.ts",
    "src/core/CodeProcessor.ts",
    "src/core/types.ts",
    "src/pipeline/Telemetry.ts",
    "src/pipeline/HistoryStore.ts",
    "bin/cli.ts",
    "ui-src/src/App.tsx",
    "ui-src/src/contexts/UIContext.tsx",
    "ui-src/src/contexts/HeaderContext.tsx",
    "ui-src/src/contexts/DistributionContext.tsx",
    "ui-src/src/components/TrafficCenter.tsx",
    "ui-src/src/components/CloudCenter.tsx",
    "ui-src/src/components/EdgeIntelligence.tsx",
    "ui-src/src/components/HeaderIntelligence.tsx"
  ],
  "name": "CloudFrontize Expert Documentation",
  "out": "docs/html",
  "theme": "default",
  "plugin": ["typedoc-material-theme"],
  "exclude": ["node_modules/**", "**/__tests__/**"],
  "cleanOutputDir": true,
  "hideGenerator": true,
  "includeVersion": true,
  "categorizeByGroup": true,
  "categoryOrder": ["Backend", "Frontend", "*"],
  "sort": ["source-order"],
  "skipErrorChecking": true
}
