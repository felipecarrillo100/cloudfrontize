{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/api/contract.ts",
    "src/server/createServer.ts",
    "src/project/loadProject.ts",
    "src/project/create.ts",
    "src/project/templates.ts",
    "src/project/build.ts",
    "src/project/importLegacy.ts",
    "src/project/runChecks.ts",
    "src/project/schema.ts",
    "src/project/settings.ts",
    "src/pipeline/Orchestrator.ts",
    "src/core/EdgeRunner.ts",
    "src/core/CFFRunner.ts",
    "src/pipeline/Providers/base.ts",
    "src/pipeline/Providers/S3Provider.ts",
    "src/pipeline/Providers/LocalProvider.ts",
    "src/pipeline/ConfigLoader.ts",
    "src/headerParser.ts",
    "src/core/HeaderManager.ts",
    "src/core/CodeProcessor.ts",
    "src/core/types.ts",
    "src/pipeline/Telemetry.ts",
    "src/pipeline/HistoryStore.ts",
    "bin/cli.ts",
    "src/core/Logger.ts",
    "src/runtime/ProjectRuntime.ts"
  ],
  "name": "CloudFrontize Expert Documentation",
  "out": "docs/html",
  "theme": "default",
  "plugin": [
    "typedoc-material-theme"
  ],
  "exclude": [
    "node_modules/**",
    "**/__tests__/**"
  ],
  "cleanOutputDir": true,
  "hideGenerator": true,
  "includeVersion": true,
  "categorizeByGroup": true,
  "categoryOrder": [
    "Backend",
    "Frontend",
    "*"
  ],
  "sort": [
    "source-order"
  ],
  "skipErrorChecking": true
}
