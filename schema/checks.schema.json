{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "type": "object",
            "properties": {
              "method": {
                "default": "GET",
                "type": "string"
              },
              "path": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^\\/.*"
              },
              "headers": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "body": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "expect": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "headers": {
                "description": "Exact header values",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "headersContain": {
                "description": "Header values that must contain the text",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "headersAbsent": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "bodyContains": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "bodyNotContains": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "request",
          "expect"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "checks"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/felipecarrillo100/cloudfrontize/main/schema/checks.schema.json",
  "title": "CloudFrontize tutorial checks"
}
